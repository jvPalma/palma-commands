/*
Enhanced CSS for PRS TUI application - 3-panel layout with beautiful styling
*/

/* Global styles */
Screen {
    background: #0d1117;
    color: #f0f6fc;
}

/* Main app container */
#app-container {
    layout: vertical;
    height: 100vh;
    background: #0d1117;
}

/* Header */
HeaderWidget {
    height: 3;
    background: #21262d;
    color: #f0f6fc;
    padding: 0 1;
    border-bottom: solid #30363d;
}

/* Main content area with 3-panel layout */
#main-content {
    layout: horizontal;
    height: 1fr;
}

/* Left panel - Navigation sidebar */
#sidebar {
    width: 25;
    background: #161b22;
    border-right: solid #30363d;
    height: 1fr;
}

.navigation-sidebar {
    padding: 1;
    height: 1fr;
}

.repo-name {
    color: #58a6ff;
    text-style: bold;
}

.username {
    color: #8b949e;
}

.section-title {
    color: #f0f6fc;
    text-style: bold;
    margin-bottom: 1;
}

.filter-button {
    width: 100%;
    height: 1;
    margin: 0;
    background: #21262d;
    color: #f0f6fc;
    border: none;
    text-align: left;
    padding: 0 1;
}

.filter-button:hover {
    background: #30363d;
}

.filter-button.active {
    background: #238636;
    color: #f0f6fc;
    text-style: bold;
}

.action-button {
    width: 100%;
    height: 1;
    margin: 0;
    background: #21262d;
    color: #f0f6fc;
    border: none;
    text-align: left;
    padding: 0 1;
}

.action-button:hover {
    background: #30363d;
}

/* Center panel */
#center-panel {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

/* Filter bar */
FilterBarWidget {
    height: 5;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 1;
}

#filter-container {
    height: 3;
    layout: horizontal;
}

#filter-input {
    height: 3;
    width: 1fr;
    background: #21262d;
    color: #f0f6fc;
    border: solid #30363d;
    padding: 1;
}

#filter-input:focus {
    border: solid #58a6ff;
}

/* Status bar */
StatusBarWidget {
    height: 1;
    background: #21262d;
    color: #f79000;
    padding: 0 1;
}

/* PR list widget */
PRListWidget {
    height: 1fr;
    background: #0d1117;
    color: #f0f6fc;
    border: solid #30363d;
    padding: 1;
}

.pr-list-view {
    height: 1fr;
    background: #0d1117;
    color: #f0f6fc;
}

.pr-container {
    height: 1fr;
    background: #0d1117;
    color: #f0f6fc;
    padding: 1;
}

.pr-item {
    height: 3;
    background: #161b22;
    color: #f0f6fc;
    padding: 1;
    margin: 0 0 1 0;
    border: solid #30363d;
}

.pr-item:hover {
    background: #21262d;
    border: solid #58a6ff;
}

.pr-item.selected {
    background: #0969da;
    border: solid #58a6ff;
}

/* Loading and empty states */
.loading-message {
    color: #58a6ff;
    text-align: center;
    height: 1fr;
    content-align: center middle;
}

.empty-message {
    color: #8b949e;
    text-align: center;
    height: 1fr;
    content-align: center middle;
}

/* PR Details panel */
#pr-details {
    height: 5;
    background: #161b22;
    border-top: solid #30363d;
}

.pr-details {
    height: 1fr;
}

.details-header {
    layout: horizontal;
    height: 1;
    background: #21262d;
    padding: 0 1;
}

.details-toggle {
    background: transparent;
    border: none;
    color: #58a6ff;
    text-style: bold;
}

.details-title {
    width: 1fr;
    color: #f0f6fc;
    text-style: bold;
    padding: 0 1;
}

.collapse-button {
    background: transparent;
    border: none;
    color: #58a6ff;
    width: 3;
}

.details-content {
    height: 1fr;
    background: #161b22;
    padding: 1;
}

.pr-details.expanded {
    height: 20;
}

/* Footer */
FooterWidget {
    height: 3;
    background: #21262d;
    color: #f0f6fc;
    padding: 0 1;
}